---
source: crates/sumi-sudoku/src/ui.rs
expression: "render_dense(&game(), &view)"
---
" sumi                         ● DIGIT "
" Move                                 "
"  hjkl  move (arrows too)             "
"  HJKL  next box                      "
"                                      "
" Write                                "
"   1-9  place, candidate or mark      "
"     0  clear the cell                "
"     n  mode: digit, candidate, mark  "
"                                      "
" Candidates and marks                 "
"     a  fill empty cells' candidates  "
"     A  refill every empty cell       "
"     t  box marks to candidates       "
"     x  clear candidates or marks     "
"     X  clear candidates and marks    "
"     v  hide or show both             "
"     f  filter: 1-9, b pairs, 0 off   "
"                                      "
" Hints and checks                     "
"     ?  hint, then its next rung      "
" Enter  apply hint, go to mistake     "
"     c  check for mistakes            "
"     r  reveal this cell              "
"   Esc  close, clear checks, menu     "
"                                      "
" Game                                 "
"     u  undo                          "
"    ^r  redo                          "
"     b  bookmark the board            "
"     B  back to a bookmark            "
"     p  pause, or carry on (Space)    "
"     i  this list                     "
"     q  quit                          "
"                                      "
"                                      "
"                                      "
"                                      "
"                                      "
"                                      "
"? for a hint                          "
"                                      "
"                                      "
"                                      "
"                                      "
"           Esc close  q quit          "
"                                      "
